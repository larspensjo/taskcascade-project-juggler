{
  "version": "2.0.0",
  "tasks": [
    { "label": "Backend build", "type": "shell", "command": "cargo build -p taskcascade-backend", "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": ["$rustc"], "group": "build" },
    { "label": "Backend test", "type": "shell", "command": "cargo test -p taskcascade-backend", "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": ["$rustc"], "group": "test" },
    { "label": "Backend clippy", "type": "shell", "command": "cargo clippy -p taskcascade-backend --all-targets -- -D warnings", "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": ["$rustc"] },
    { "label": "Desktop build", "type": "shell", "command": "cargo build -p taskcascade-desktop", "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": ["$rustc"], "group": "build" },
    { "label": "Workspace test", "type": "shell", "command": "cargo test --workspace", "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": ["$rustc"], "group": "test" },
    { "label": "Workspace clippy", "type": "shell", "command": "cargo clippy --workspace --all-targets -- -D warnings", "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": ["$rustc"] },
    { "label": "Frontend install", "type": "shell", "command": "npm.cmd install", "options": { "cwd": "${workspaceFolder}/frontend" }, "problemMatcher": [] },
    { "label": "Frontend build", "type": "shell", "command": "npm.cmd run build", "options": { "cwd": "${workspaceFolder}/frontend" }, "problemMatcher": ["$tsc"], "group": "build" },
    { "label": "Frontend test", "type": "shell", "command": "npm.cmd test", "options": { "cwd": "${workspaceFolder}/frontend" }, "problemMatcher": [], "group": "test" },
    { "label": "Frontend check", "type": "shell", "command": "npm.cmd run check", "options": { "cwd": "${workspaceFolder}/frontend" }, "problemMatcher": ["$tsc"] },
    { "label": "Start development window", "type": "shell", "command": "./scripts/start.ps1", "options": { "cwd": "${workspaceFolder}", "shell": { "executable": "pwsh", "args": ["-NoProfile", "-Command"] } }, "problemMatcher": [] },
    { "label": "Install TaskCascade", "type": "shell", "command": "./scripts/install.ps1", "options": { "cwd": "${workspaceFolder}", "shell": { "executable": "pwsh", "args": ["-NoProfile", "-Command"] } }, "problemMatcher": [] },
    { "label": "Check all", "dependsOrder": "sequence", "dependsOn": ["Workspace test", "Workspace clippy", "Frontend test", "Frontend check"], "problemMatcher": [] }
  ]
}
